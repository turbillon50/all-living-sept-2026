# Base de datos (Neon, proyecto propio de ALL LIVING)
DATABASE_URL=
# Clerk (app propia de ALL LIVING)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Firma de tokens temporales (Living Pass, accesos). 32+ bytes aleatorios.
ACCESS_TOKEN_SECRET=
# Adaptadores externos: si la variable está vacía se usa el adaptador local/mock.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAPBOX_TOKEN=
# Duffel: live in production, test in preview.
DUFFEL_ACCESS_TOKEN=
# Reloadly: server-side catalog access. Purchasing is not enabled.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_ENV=live
# Ticketmaster Discovery API. Sólo servidor; nunca usar NEXT_PUBLIC_.
TICKETMASTER_API_KEY=
# Cuando Impact entregue el valor, genera la meta etiqueta sin tocar componentes.
IMPACT_SITE_VERIFICATION=
# Seed
SEED_DEMO=true
# Correos que reciben admin+operator al primer acceso (coma). Nunca desde la UI.
ADMIN_EMAILS=
# URL pública (ligas de invitación)
NEXT_PUBLIC_APP_URL=
